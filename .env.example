PORT=8080
JPA_DDL_AUTO=update

# Local development can omit these and use the bundled H2 database.
# For Render/PostgreSQL, prefer SPRING_DATASOURCE_URL with a JDBC URL:
# SPRING_DATASOURCE_URL=jdbc:postgresql://host:5432/database
# SPRING_DATASOURCE_USERNAME=database_user
# SPRING_DATASOURCE_PASSWORD=database_password

# Render-style DATABASE_URL values such as postgres://user:pass@host:5432/db
# are also supported and converted by the application at startup.
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=
